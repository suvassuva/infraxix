# ==============================================================================
# PVG Ops - Environment Configuration Template
# Offline-First Field Verification Platform
# ==============================================================================

# Application Branding & Identity
NEXT_PUBLIC_APP_NAME="PVG Ops"
NEXT_PUBLIC_APP_VERSION="1.0.0-alpha"
NEXT_PUBLIC_ENVIRONMENT="development"

# ==============================================================================
# DATA SOURCE CONFIGURATION
# Options:
#   - 'mock'     : Default offline mode. Uses in-memory & localStorage repositories
#                  (MockAuthRepository, MockRecordRepository, MockMediaRepository).
#                  Zero network calls to Firebase, zero credentials required.
#   - 'firebase' : Connects to Firebase Auth, Cloud Firestore, and Cloud Storage.
#                  Requires valid client configuration variables below.
# ==============================================================================
NEXT_PUBLIC_DATA_SOURCE="mock"
NEXT_PUBLIC_DEMO_MODE=true

# ==============================================================================
# OPTIONAL: FIREBASE CLIENT SDK CONFIGURATION
# (Only evaluated when NEXT_PUBLIC_DATA_SOURCE="firebase")
# Retrieve these values from the Firebase Console: Project Settings > General > Your apps
# ==============================================================================
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
# NEXT_PUBLIC_FIREBASE_APP_ID=""

# ==============================================================================
# SECURITY POLICY AND CREDENTIAL SAFEGUARDS:
# 1. NEVER put Firebase Admin private keys or service account credentials in this file
#    or any file starting with NEXT_PUBLIC_ (they are bundled into the browser bundle).
# 2. NEVER commit service-account.json or *.key files to Git or source control.
# 3. Keep .env.local in your local environment only (verified in .gitignore).
# ==============================================================================
