rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserRole() {
      return request.auth.token.role != null
        ? request.auth.token.role
        : (getUserData() != null && getUserData().role != null ? getUserData().role : 'officer');
    }

    function isOfficer() {
      return isAuthenticated();
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function hasValidMetadataOnly() {
      // Strictly prevent media binary payloads in Firestore documents
      return !('binary' in request.resource.data)
          && !('fileData' in request.resource.data)
          && !('blob' in request.resource.data)
          && !('buffer' in request.resource.data);
    }

    function isValidCoordinates(data) {
      return !('location' in data) || data.location == null || (
        data.location.latitude is number &&
        data.location.latitude >= -90.0 &&
        data.location.latitude <= 90.0 &&
        data.location.longitude is number &&
        data.location.longitude >= -180.0 &&
        data.location.longitude <= 180.0 &&
        (!('accuracy' in data.location) || data.location.accuracy == null || (data.location.accuracy is number && data.location.accuracy >= 0))
      );
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Records Collection
    match /records/{recordId} {
      // Authenticated users can read records
      allow read: if isAuthenticated();

      // Field officers can create records with verified identity & ownership
      allow create: if isOfficer()
        // NEVER trust ownerUid from browser input: must strictly match request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 120
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.status in ['draft', 'pending']
        && isValidCoordinates(request.resource.data)
        && hasValidMetadataOnly();

      // Updates:
      // - ownerUid is strictly immutable
      // - Authenticated personnel can update status, notes, verification, specs
      allow update: if isAuthenticated()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && hasValidMetadataOnly();

      // Deletions: Authenticated personnel
      allow delete: if isAuthenticated();
    }

    // Immutable Audit Logs Collection
    match /auditLogs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Append-only audit integrity
    }
  }
}
